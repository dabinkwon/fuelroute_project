# Copy to .env. Never commit actual keys.
GMS_API_KEY=
# Paste the HTTPS API base (through /v1); a full /chat/completions URL is normalized.
GMS_BASE_URL=
# Candidate only: check that your GMS account offers this model.
GMS_MODEL=gpt-5.4-mini
OPINET_API_KEY=
KAKAO_REST_API_KEY=
# Use the decoded service key. The HTTP client URL-encodes it once.
DATA_GO_KR_SERVICE_KEY=
HTTP_TIMEOUT_SECONDS=20
# Optional local SQLite file; created only when session memory is used.
DATABASE_PATH=data/fuelroute.sqlite3

